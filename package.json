{
  "name": "trem-lite",
  "version": "26.1.0-26w39a",
  "author": "ExpTechTW <ExpTech.tw@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/ExpTechTW/TREM-Lite.git"
  },
  "description": "Taiwan Real-time Earthquake Monitoring — web + desktop (Tauri) monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter @trem/desktop dev",
    "dev:web": "bun run --filter @trem/web dev",
    "dev:core": "bun run --filter @trem/core dev",
    "build": "bun run --filter @trem/desktop build",
    "build:web": "bun run --filter @trem/web build",
    "build:core": "bun run --filter @trem/core build",
    "tauri": "bun run --filter @trem/desktop tauri",
    "lint": "bun run --filter @trem/core lint",
    "typecheck": "bun run --filter @trem/core typecheck"
  },
  "dependencies": {
    "maplibre-gl": "6.4.1"
  }
}
