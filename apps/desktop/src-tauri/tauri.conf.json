{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TREM-Lite",
  "version": "26.1.0-26w39a",
  "identifier": "com.exptech.trem-lite",
  "build": {
    "beforeDevCommand": "bun run --filter @trem/core dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run --filter @trem/core build",
    "frontendDist": "../../../packages/core/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TREM Lite",
        "width": 1280,
        "height": 815,
        "minWidth": 900,
        "minHeight": 680,
        "visible": false,
        "resizable": true,
        "fullscreen": false,
        "maximizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "category": "Utility",
    "shortDescription": "Taiwan Real-time Earthquake Monitoring",
    "longDescription": "TREM (Taiwan Real-time Earthquake Monitoring) provides real-time earthquake information and earthquake early warnings."
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ExpTechTW/TREM-Lite/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY0MDdBQzFCNjQxMEJGNkUKUldSdXZ4QmtHNndIOUVPOWpXQndtRFI2ZEROcnMxRCtnd1ZCWkdZeERoWjlHZWwxdWFkWkFhRVIK"
    }
  }
}
